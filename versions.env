# The bootstrap downloads an immutable Determinate Nix Installer release and
# verifies the platform binary before executing it.
NIX_INSTALLER_VERSION=v3.21.0
NIX_INSTALLER_SHA256_X86_64=b9911496659f0c35c642353d592926c024c205b597e8094bf73a42908a75e462
NIX_INSTALLER_SHA256_AARCH64=d2ede080a0a7b34119362f4a8a6fb5e49a4d16b302ce54c96cd05514bdea6c7c

# Hermes is installed by its official, supported installer at this exact
# release commit. ./dev-env update advances both values together.
HERMES_VERSION=v0.22.5
HERMES_COMMIT=bf0203a794a07aac3ff764972ab9087baa4e4f4e
